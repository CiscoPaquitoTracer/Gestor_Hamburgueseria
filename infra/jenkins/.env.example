# Copia este archivo como .env (no se sube a git).
#
# DOCKER_GID = grupo dueño del socket de Docker.
#   Linux:                     getent group docker | cut -d: -f3
#   Docker Desktop (Windows/macOS) o cualquier sistema:
#     docker run --rm -v /var/run/docker.sock:/var/run/docker.sock alpine stat -c %g /var/run/docker.sock
#   En Docker Desktop normalmente es 0.
DOCKER_GID=
