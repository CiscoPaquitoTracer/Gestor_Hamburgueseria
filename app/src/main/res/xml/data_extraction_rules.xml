<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. El inventario sí se respalda; la sesión no (obliga a volver a iniciar con Google). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="sesion.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="sesion.xml" />
    </device-transfer>
</data-extraction-rules>
